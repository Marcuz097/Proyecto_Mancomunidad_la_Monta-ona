@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item"><span class="nav-link text-dark">Hola, @User.Identity?.Name</span></li>
    <li class="nav-item">
        <form class="form-inline" method="post" action="/Identity/Account/Logout?returnUrl=%2F">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-link btn btn-link text-dark border-0">Cerrar sesión</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link text-dark" href="/Identity/Account/Register">Registrarse</a></li>
    <li class="nav-item"><a class="nav-link text-dark" href="/Identity/Account/Login">Iniciar sesión</a></li>
}
</ul>
