@page "/alianzas"
@inject ApplicationDbContext Db

<PageTitle>Alianzas · Mancomunidad La Montañona</PageTitle>

<PageBanner Migaja="Alianzas"
            Titulo="Convenios y alianzas"
            Subtitulo="Trabajamos con organizaciones que comparten el compromiso con el territorio."
            Imagen="/img/turismo-sendero.jpg" Posicion="center 60%" />

<section class="s alt">
    <div class="wrap">
        <div class="h2w rv">
            <span class="eyebrow">Quiénes nos acompañan</span>
            <h2>Nuestras alianzas</h2>
        </div>
        @if (alianzas.Count == 0)
        {
            <p class="meta">Pronto compartiremos aquí a las organizaciones aliadas.</p>
        }
        <div class="al">
            @for (var i = 0; i < alianzas.Count; i++)
            {
                var a = alianzas[i];
                <article class="ac rv @(i % 3 == 1 ? "d1" : i % 3 == 2 ? "d2" : "")">
                    <div class="lo">
                        @if (a.RutaLogo is not null)
                        {
                            <img src="@a.RutaLogo" alt="@a.Nombre" style="max-height:74px;max-width:100%;object-fit:contain" />
                        }
                        else
                        {

                            @a.Nombre
                        }
                    </div>
                    <h3>@a.Nombre</h3>
                    <p>@a.Descripcion</p>
                </article>
            }
        </div>
    </div>
</section>

<section class="band">
    <div class="wrap">
        <div>
            <h2>¿Tu organización quiere sumarse?</h2>
            <p>Escríbenos y conversemos sobre un convenio de cooperación.</p>
        </div>
        <div class="ct">
            <a class="boton ambar" href="mailto:salvaguardia@@mlm.org.sv"><svg class="i" viewBox="0 0 24 24"><path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm0 1 8 6 8-6" /></svg> salvaguardia@@mlm.org.sv</a>
        </div>
    </div>
</section>

@code {
    List<Alianza> alianzas = new();

    protected override async Task OnInitializedAsync() =>
        alianzas = await Db.Alianzas.AsNoTracking().Where(a => a.Publicada)
            .OrderBy(a => a.Orden).ThenBy(a => a.Nombre).ToListAsync();
}
