@using Microsoft.AspNetCore.Components.Authorization
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <main class="form-page"><div class="wrap narrow">
                    <h1>Acceso restringido</h1>
                    <p class="intro">Necesitas iniciar sesión con una cuenta autorizada para ver esta sección.</p>
                    <a class="btn" href="/Identity/Account/Login">Iniciar sesión</a>
                </div></main>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)"><p style="padding:40px">Página no encontrada.</p></LayoutView>
    </NotFound>
</Router>
